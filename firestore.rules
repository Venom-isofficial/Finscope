rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny catch-all rule
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isSignedIn() && resource.data.userId == request.auth.uid;
    }

    function incomingDocOwner() {
      return isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    // --- USERS Collection ---
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // --- WATCHLISTS Collection ---
    match /watchlists/{watchlistId} {
      allow create: if isSignedIn() && incomingDocOwner();
      allow read, update, delete: if isSignedIn() && (resource == null || isDocOwner());
    }

    // --- SAVED ARTICLES Collection ---
    match /savedArticles/{savedArticleId} {
      allow create: if isSignedIn() && incomingDocOwner();
      allow read, update, delete: if isSignedIn() && (resource == null || isDocOwner());
    }

    // --- ALERTS Collection ---
    match /alerts/{alertId} {
      allow create: if isSignedIn() && incomingDocOwner();
      allow read, update, delete: if isSignedIn() && (resource == null || isDocOwner());
    }

    // --- RECENT SEARCHES Collection ---
    match /recentSearches/{recentSearchId} {
      allow create: if isSignedIn() && incomingDocOwner();
      allow read, update, delete: if isSignedIn() && (resource == null || isDocOwner());
    }

    // --- NOTIFICATIONS Collection ---
    match /notifications/{notificationId} {
      allow create: if isSignedIn() && incomingDocOwner();
      allow read, update, delete: if isSignedIn() && (resource == null || isDocOwner());
    }

    // --- CHAT HISTORY Collection ---
    match /chatHistory/{chatId} {
      allow create: if isSignedIn() && incomingDocOwner();
      allow read, update, delete: if isSignedIn() && (resource == null || isDocOwner());
    }

    // --- SETTINGS Collection ---
    match /settings/{userId} {
      allow read, write: if isOwner(userId);
    }
  }
}
